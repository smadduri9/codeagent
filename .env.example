# Copy to .env (git-ignored) and fill in locally. Never commit .env. Never paste the key into a chat.
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_key_here

# Optional: sets [model].main only (not cheap). Same lookup order as the API key:
# process environment, then <repo>/.env, then ~/.codeagent/.env
# CODEAGENT_MODEL=openai/gpt-oss-120b
